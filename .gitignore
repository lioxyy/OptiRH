# ─── Dependency directories ───────────────────────────────────────────────────
node_modules/

# ─── Build artifacts ──────────────────────────────────────────────────────────
dist/
dist-app/
dist-electron/
dist-renderer/
out/
build/
*.exe
*.dmg
*.AppImage

# ─── Databases (SQLite — never commit data files) ─────────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.db-shm
*.db-wal
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-shm
/prisma/dev.db-wal
/prisma/test.db
/prisma/test.db-journal
/prisma/*.db

# ─── Environment variables ────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Test output & coverage ───────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
/prisma/prisma/

# ─── Prisma migrations (local only) ──────────────────────────────────────────
/prisma/migrations/

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# ─── Local overrides ─────────────────────────────────────────────────────────
.gitignore_local