{
  "name": "optirh",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "electron",
    "renderer"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "npm run dev --workspace=renderer",
    "dev:electron": "npm run dev --workspace=electron",
    "start": "electron electron/",
    "build": "npm run build --workspace=renderer && npm run build --workspace=electron",
    "package": "npm run build && electron-builder"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tsx": "^4.22.0",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.optirh.app",
    "productName": "OptiRH",
    "directories": { "output": "dist-app" },
    "files": [
      "electron/dist/**/*",
      "renderer/dist/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/.prisma/**/*"
    ],
    "extraResources": [
      { "from": "prisma/migrations", "to": "migrations" }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}